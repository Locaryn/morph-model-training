      "install_source": "Locaryn/morph-model-training#v2.0.0"
    },
    {
      "version": "1.5.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.5.0",
      "tag": "v1.5.0",
      "released_at": "2026-08-27",
      "install_source": "Locaryn/morph-model-training#v1.5.0"
    },
    {
      "version": "1.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v1.0.0",
