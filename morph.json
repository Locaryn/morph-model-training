{
  "$schema": "https://locaryn.dev/schema/morph.json/v0.1",
  "apiVersion": "0.1",
  "name": "morph-model-training",
  "version": "2.1.0-beta.1",
  "description": "NON FONCTIONNEL (squelette d'API) — Entraînement LoRA, gestion des adaptateurs, quantification GGUF et oblitération de modèles. Aucun moteur n'est embarqué : les appels échouent explicitement au lieu de fabriquer un résultat.",
  "author": "Locaryn Team",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Locaryn/morph-model-training",
  "repository": "https://github.com/Locaryn/morph-model-training",
  "keywords": [
    "model-training",
    "lora",
    "gguf-quantization",
    "fine-tuning",
    "obliteration"
  ],
  "permissions": {
    "mcp": {
      "reason": "Lancer le gestionnaire d'entraînement et de quantification local."
    },
    "files.read": {
      "reason": "Lire les modèles de base et adaptateurs LoRA."
    },
    "files.write": {
      "reason": "Sauvegarder les fichiers quantifiés et adaptateurs entraînés."
    }
  },
  "components": {
    "skills": [
      "SKILL.md"
    ],
    "mcp": "mcp/mcp.json"
  },
  "capabilities": [
    "model-training"
  ],
  "ui_contributions": {
    "slots": [
      {
        "id": "model-training-catalog",
        "slot": "marketplace.catalogs",
        "order": 19,
        "type": "data",
        "label": "Adaptateurs & Outils d'entraînement",
        "icon": "lock",
        "entry": "dist/marketplace.json",
        "hint": "Ajoute les modèles et adaptateurs LoRA au catalogue"
      },
      {
        "id": "model-training-studio",
        "slot": "studio.tabs",
        "order": 19,
        "label": "Entraînement & LoRA",
        "icon": "lock",
        "type": "custom-element",
        "entry": "dist/ui.js",
        "tag": "locaryn-model-training-panel",
        "hint": "Gestion des adaptateurs LoRA et quantification GGUF"
      },
      {
        "id": "training-lora",
        "slot": "nav.drawer",
        "order": 19,
        "type": "custom-element",
        "label": "Entraînement & LoRA",
        "icon": "shield",
        "entry": "dist/ui.js",
        "tag": "locaryn-model-training-panel",
        "hint": "Adaptateurs LoRA, quantification GGUF et oblitération"
      }
    ],
    "nav_items": []
  },
  "beta": true,
  "stability": "untested",
  "versions": [
    {
      "version": "2.1.0-beta.1",
      "is_beta": true,
      "summary": "Version Bêta (2.1.0-beta.1) — pre-release non testée par des utilisateurs",
      "tag": "v2.1.0-beta.1",
      "released_at": "2026-08-29",
      "install_source": "Locaryn/morph-model-training#v2.1.0-beta.1"
    },
    {
      "version": "2.0.0",
      "is_beta": false,
      "summary": "Version stable de référence v2.0.0",
